---
import RefVisual from './RefVisual.astro';
import { u, typeOf, TYPE_META, TIER_META } from '../lib/meta';

interface Props {
  ref: { id: string; data: any };
  brandName: string;
}
const { ref, brandName } = Astro.props;
const d = ref.data;
const t = typeOf(d.type);
---

<a
  href={u(`catalogue/${ref.id}/`)}
  class="card ref-card"
  data-id={ref.id}
 
  data-type={t}
  data-tier={d.price_tier}
  data-levels={d.levels.join(' ')}
  data-styles={d.styles.join(' ')}
>
  <div class="ref-card__visual"><RefVisual ref={ref} brandName={brandName} size="230px" /></div>
  <div class="ref-card__meta">
    <span class="eyebrow">{brandName}</span>
    <h3 class="display h4">{d.name}</h3>
    <p class="mono muted">
      {[d.case?.diameter_mm && `${d.case.diameter_mm} mm`, d.water_resistance_m && `${d.water_resistance_m} m`, d.caliber].filter(Boolean).join(' · ')}
    </p>
    <div class="ref-card__chips">
      <span class="chip">{TYPE_META[t].name}</span>
      <span class="chip">{TIER_META[d.price_tier as keyof typeof TIER_META].name}</span>
    </div>
  </div>
</a>

<style>
  .ref-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background-image: none;
    transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease), opacity 0.3s;
  }
  .ref-card__visual {
    display: grid;
    place-items: center;
    padding: 22px 0 18px;
    border: var(--bw) solid var(--ink);
    border-radius: 10px;
    background-color: var(--stripe, var(--c-yellow));
    background-image: radial-gradient(rgba(17, 17, 17, 0.16) 1.2px, transparent 1.4px);
    background-size: 14px 14px;
    transition: background-color 0.2s;
  }
  .ref-card__visual > :global(*) {
    transition: transform 0.35s var(--snap);
  }
  .ref-card:hover .ref-card__visual > :global(*) {
    transform: rotate(-6deg) scale(1.03);
  }
  .ref-card h3 {
    margin: 12px 0 6px;
  }
  .ref-card p {
    margin: 0 0 14px;
  }
  .ref-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ref-card.is-filtered {
    display: none;
  }
</style>
