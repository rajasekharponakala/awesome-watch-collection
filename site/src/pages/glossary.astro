---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { u, LEVEL_META } from '../lib/meta';

const terms = (await getCollection('glossary')).sort((a, b) => a.id.localeCompare(b.id));
const letter = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '')[0].toUpperCase();
const letters = [...new Set(terms.map((t) => letter(t.data.term)))];
const idOf = (term: string) => terms.find((t) => t.data.term === term)?.id;
---

<Base title="Glossary" description="Every watch term explained, from anglage to Zaratsu.">
  <PageHero
    eyebrow={`${terms.length} terms`}
    title="Speak <em>watch.</em>"
    lede="The vocabulary of horology, A to Z. Each term is tagged with the level at which you will usually meet it."
    crumbs={[[u(), 'Dial'], [u('glossary/'), 'Glossary']]}
  />
  <section class="section--tight">
    <div class="container">
      <div class="gl-bar">
        <input type="search" class="gl-search" placeholder="Filter terms…" data-gl-filter aria-label="Filter glossary terms" />
        <nav class="gl-letters mono" aria-label="Letters">{letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}</nav>
      </div>
      {letters.map((l) => (
        <section class="gl-group" id={`letter-${l}`} data-gl-group>
          <h2 class="display gl-letter" data-reveal="fade">{l}</h2>
          <div class="grid grid--3">
            {terms.filter((t) => letter(t.data.term) === l).map((t) => (
              <article class="card gl-term" id={t.id} data-gl-term={`${t.data.term} ${t.data.short}`.toLowerCase()}>
                <div class="gl-head">
                  <h3 class="display h4">{t.data.term}</h3>
                  <span class="jewels" title={LEVEL_META[t.data.level].name}>{[1, 2, 3, 4].map((j) => <i class={j > LEVEL_META[t.data.level].jewels ? 'off' : ''} />)}</span>
                </div>
                <p class="muted">{t.data.short}</p>
                {t.data.related.length > 0 && (
                  <p class="gl-rel mono">See: {t.data.related.map((r) => (idOf(r) ? <a href={`#${idOf(r)}`}>{r}</a> : <span>{r}</span>))}</p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-gl-filter]');
  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    document.querySelectorAll<HTMLElement>('[data-gl-group]').forEach((g) => {
      let any = false;
      g.querySelectorAll<HTMLElement>('[data-gl-term]').forEach((t) => {
        const ok = !q || (t.dataset.glTerm || '').includes(q);
        t.hidden = !ok;
        if (ok) any = true;
      });
      g.hidden = !any;
    });
  });
</script>

<style>
  .gl-bar { position: sticky; top: calc(var(--header-h) + 8px); z-index: 5; display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding: 14px; margin-bottom: 36px; border-radius: var(--radius); border: var(--bw) solid var(--ink); background: var(--surface); box-shadow: var(--shadow); }
  .gl-search { flex: 1 1 220px; min-width: 0; height: 46px; padding: 0 16px; border-radius: 10px; border: var(--bw-sm) solid var(--ink); background: var(--surface-2); color: var(--text); font: 600 15px var(--sans); }
  .gl-search::placeholder { color: var(--faint); }
  .gl-search:focus { outline: none; background: var(--c-yellow); color: #111; box-shadow: var(--shadow-sm); }
  .gl-letters { display: flex; flex-wrap: wrap; gap: 2px; }
  .gl-letters a { display: grid; place-items: center; width: 30px; height: 30px; border: var(--bw-sm) solid transparent; border-radius: 6px; font-size: 13px; font-weight: 700; color: var(--text); }
  .gl-letters a:hover { border-color: var(--ink); background: var(--c-yellow); color: #111; box-shadow: 2px 2px 0 var(--ink); }
  .gl-group { scroll-margin-top: calc(var(--header-h) + 100px); margin-bottom: 50px; }
  .gl-letter { font-size: 90px; line-height: 1; color: var(--c-yellow); -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill; text-shadow: 6px 6px 0 var(--ink); margin: 0 0 24px; }
  .gl-term { scroll-margin-top: calc(var(--header-h) + 100px); }
  .gl-term:target { background-color: var(--c-yellow); --text: #111; --muted: #2b2925; --faint: #45423c; --gold: #111; color: #111; }
  .gl-head { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .gl-term h3 { margin: 0 0 10px; }
  .gl-term p { margin: 0; font-size: 15px; }
  .gl-rel { margin-top: 14px !important; font-size: 11.5px !important; display: flex; flex-wrap: wrap; gap: 6px 10px; color: var(--faint); }
  .gl-rel a { padding: 0 5px; border: var(--bw-sm) solid var(--ink); border-radius: 4px; color: var(--text); font-weight: 700; }
  .gl-rel a:hover { background: var(--c-blue); color: #111; }
</style>
