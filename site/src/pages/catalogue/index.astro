---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import RefCard from '../../components/RefCard.astro';
import { u, TYPES, TYPE_META, TIERS, TIER_META, LEVELS, LEVEL_META } from '../../lib/meta';

const refs = (await getCollection('references')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const brands = await getCollection('brands');
const brandName = (id: string) => brands.find((b) => b.id === id)?.data.name ?? id;
const ring = ['all', ...TYPES] as const;
const step = 360 / ring.length;
---

<Base title="Catalogue" description="Iconic watch references across every type, style and price tier.">
  <PageHero
    eyebrow="The catalogue"
    title="Turn the <em>bezel.</em>"
    lede="Rotate the bezel to filter by family, then refine by price tier and level. Every card shows the current time."
    crumbs={[[u(), 'Dial'], [u('catalogue/'), 'Catalogue']]}
  />

  <section class="section--tight cat">
    <div class="container cat__grid">
      <aside class="cat__filters" data-filters>
        <div class="bezel" data-bezel style="--rot:0deg">
          <svg viewBox="0 0 300 300" class="bezel__ring" aria-hidden="true">
            <circle cx="150" cy="150" r="140" fill="var(--surface-2)" stroke="var(--line-2)" />
            <circle cx="150" cy="150" r="96" fill="var(--bg)" stroke="var(--line-2)" />
            {Array.from({ length: 60 }, (_, i) => (
              <line x1="150" y1="14" x2="150" y2={i % 5 ? 20 : 26} stroke="var(--faint)" stroke-width={i % 5 ? 0.8 : 1.4} transform={`rotate(${i * 6} 150 150)`} />
            ))}
          </svg>
          <div class="bezel__labels">
            {ring.map((t, i) => (
              <button
                class="bezel__label"
                style={`--a:${i * step}deg`}
                data-type-btn={t}
                data-angle={i * step}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span>{t === 'all' ? 'All' : TYPE_META[t].name.split(' ')[0]}</span>
              </button>
            ))}
          </div>
          <div class="bezel__pip" aria-hidden="true"></div>
          <div class="bezel__center">
            <b class="display" data-count-out>{refs.length}</b>
            <span class="mono">references</span>
          </div>
        </div>

        <div class="cat__group">
          <span class="eyebrow">Price tier</span>
          <div class="cat__chips">
            {TIERS.map((t) => <button class="chip" data-tier-btn={t} aria-pressed="false">{TIER_META[t].name}</button>)}
          </div>
        </div>
        <div class="cat__group">
          <span class="eyebrow">Level</span>
          <div class="cat__chips">
            {LEVELS.map((l) => <button class="chip" data-level-btn={l} aria-pressed="false">{LEVEL_META[l].name}</button>)}
          </div>
        </div>
        <button class="btn btn--ghost cat__reset" data-reset>Reset to 12 o'clock</button>
      </aside>

      <div class="grid grid--3 cat__cards" data-cards>
        {refs.map((r) => <RefCard ref={r} brandName={brandName(r.data.brand)} />)}
        <p class="cat__empty muted" data-empty hidden>No references match these settings yet. <a href="https://github.com/rajasekharponakala/awesome-watch-collection/blob/main/CONTRIBUTING.md">Add one →</a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  const bezel = document.querySelector<HTMLElement>('[data-bezel]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-cards] .ref-card'));
  const out = document.querySelector('[data-count-out]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  let type = 'all';
  const tiers = new Set<string>();
  const levels = new Set<string>();
  let rot = 0;

  function apply() {
    let n = 0;
    for (const c of cards) {
      const ok =
        (type === 'all' || c.dataset.type === type) &&
        (!tiers.size || tiers.has(c.dataset.tier || '')) &&
        (!levels.size || (c.dataset.levels || '').split(' ').some((l) => levels.has(l)));
      c.classList.toggle('is-filtered', !ok);
      if (ok) n++;
    }
    if (out) out.textContent = String(n);
    if (empty) empty.hidden = n > 0;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-type-btn]').forEach((b) =>
    b.addEventListener('click', () => {
      type = b.dataset.typeBtn || 'all';
      const target = -parseFloat(b.dataset.angle || '0');
      // rotate the shortest way, like a real bezel
      let delta = ((target - rot) % 360 + 540) % 360 - 180;
      rot += delta;
      bezel?.style.setProperty('--rot', `${rot}deg`);
      document.querySelectorAll('[data-type-btn]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }),
  );
  const toggler = (attr: string, set: Set<string>) =>
    document.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((b) =>
      b.addEventListener('click', () => {
        const v = b.getAttribute(attr) || '';
        set.has(v) ? set.delete(v) : set.add(v);
        b.setAttribute('aria-pressed', String(set.has(v)));
        apply();
      }),
    );
  toggler('data-tier-btn', tiers);
  toggler('data-level-btn', levels);
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    tiers.clear();
    levels.clear();
    document.querySelectorAll('[data-tier-btn],[data-level-btn]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
    (document.querySelector('[data-type-btn="all"]') as HTMLButtonElement | null)?.click();
  });
  const pre = new URLSearchParams(location.search).get('type');
  if (pre) (document.querySelector(`[data-type-btn="${CSS.escape(pre)}"]`) as HTMLButtonElement | null)?.click();
</script>

<style>
  .cat__grid { display: grid; grid-template-columns: 320px 1fr; gap: 48px; align-items: start; }
  .cat__filters { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 30px; }
  .bezel { position: relative; width: 300px; max-width: 100%; aspect-ratio: 1; margin: 0 auto; }
  .bezel__ring, .bezel__labels {
    position: absolute;
    inset: 0;
    transform: rotate(var(--rot));
    transition: transform 1.1s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .bezel__ring { width: 100%; height: 100%; }
  .bezel__label {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 84px;
    height: 30px;
    margin: -15px 0 0 -42px;
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    color: var(--muted);
    font: 500 10.5px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(var(--a)) translateY(-118px);
    transition: color 0.3s;
  }
  .bezel__label:hover, .bezel__label[aria-pressed='true'] { color: var(--gold); }
  .bezel__label[aria-pressed='true'] span { font-weight: 600; }
  .bezel__pip {
    position: absolute;
    left: 50%;
    top: -10px;
    width: 0;
    height: 0;
    margin-left: -8px;
    border: 8px solid transparent;
    border-top: 12px solid var(--gold);
    filter: drop-shadow(0 0 8px var(--gold));
  }
  .bezel__center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; pointer-events: none; }
  .bezel__center b { font-size: 64px; line-height: 1; font-weight: 500; }
  .bezel__center span { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--faint); }
  .cat__group { display: grid; gap: 12px; }
  .cat__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .cat__reset { justify-content: center; }
  .cat__empty { grid-column: 1 / -1; }
  .cat__empty a { color: var(--gold); }
  @media (max-width: 960px) {
    .cat__grid { grid-template-columns: 1fr; }
    .cat__filters { position: relative; top: 0; }
  }
</style>
