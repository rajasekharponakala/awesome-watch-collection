---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RefVisual from '../../components/RefVisual.astro';
import RefCard from '../../components/RefCard.astro';
import Rings from '../../components/Rings.astro';
import { u, typeOf, subtypeOf, TYPE_META, TIER_META, LEVEL_META } from '../../lib/meta';

export async function getStaticPaths() {
  const refs = await getCollection('references');
  return refs.map((r) => ({ params: { id: r.id }, props: { ref: r } }));
}
const { ref } = Astro.props;
const d = ref.data;
const brands = await getCollection('brands');
const brand = brands.find((b) => b.id === d.brand);
const calibers = await getCollection('calibers');
const cal = d.caliber_id ? calibers.find((c) => c.id === d.caliber_id) : undefined;
const t = typeOf(d.type);
const related = (await getCollection('references')).filter((r) => r.id !== ref.id && (r.data.brand === d.brand || typeOf(r.data.type) === t)).slice(0, 3);
const brandName = (id: string) => brands.find((b) => b.id === id)?.data.name ?? id;

const specs: [string, string | undefined][] = [
  ['Reference', d.reference],
  ['Family', `${TYPE_META[t].name} · ${subtypeOf(d.type)}`],
  ['Movement', d.caliber],
  ['Case', d.case.material],
  ['Diameter', d.case.diameter_mm ? `${d.case.diameter_mm} mm` : undefined],
  ['Lug-to-lug', d.case.lug_to_lug_mm ? `${d.case.lug_to_lug_mm} mm` : undefined],
  ['Thickness', d.case.thickness_mm ? `${d.case.thickness_mm} mm` : undefined],
  ['Lug width', d.case.lug_width_mm ? `${d.case.lug_width_mm} mm` : undefined],
  ['Water resistance', d.water_resistance_m ? `${d.water_resistance_m} m` : undefined],
  ['Crystal', d.crystal],
  ['Functions', d.complications.length ? d.complications.join(', ') : undefined],
  ['Style', d.styles.join(', ')],
  ['Produced', d.years.introduced ? `${d.years.introduced}${d.years.discontinued ? `–${d.years.discontinued}` : '–present'}` : undefined],
  ['Origin', d.region],
  ['Price tier', `${TIER_META[d.price_tier].name} (${TIER_META[d.price_tier].range})`],
];
---

<Base title={`${brand?.data.name ?? ''} ${d.name}`} description={d.summary}>
  <section class="ref-hero">
    <div class="ref-hero__rings" data-parallax="0.3"><Rings /></div>
    <div class="container ref-hero__grid">
      <div class="ref-hero__visual" data-reveal="scale">
        <div class="ref-hero__follow" data-follow><RefVisual ref={ref} brandName={brand?.data.name ?? ''} size="min(500px, 84vw)" /></div>
      </div>
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb" data-reveal="fade">
          <a href={u()}>Dial</a><span>/</span><a href={u('catalogue/')}>Catalogue</a><span>/</span>
          <a href={u(`brands/${d.brand}/`)}>{brand?.data.name}</a>
        </nav>
        <span class="eyebrow" data-reveal="fade">{brand?.data.name}{d.reference ? ` · Ref. ${d.reference}` : ''}</span>
        <h1 class="display h2" data-reveal style="margin:18px 0 22px">{d.name}</h1>
        <p class="lede" data-reveal>{d.summary}</p>
        <div class="ref-hero__chips" data-reveal>
          {d.levels.map((l) => <span class="chip">{LEVEL_META[l].name}</span>)}
          {d.styles.map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container warranty" data-reveal>
      <div class="warranty__head">
        <span class="eyebrow">Certificate · Spec sheet</span>
        <span class="mono muted">Serviced {d.last_reviewed.toISOString().slice(0, 10)}</span>
      </div>
      <dl class="specs">
        {specs.filter(([, v]) => v).map(([k, v]) => (
          <div><dt>{k}</dt><dd>{k === 'Movement' && cal ? <a href={u(`calibers/#${cal.id}`)} class="gold-link">{v}</a> : v}</dd></div>
        ))}
      </dl>
      {d.sources.length > 0 && (
        <p class="mono muted sources">Sources: {d.sources.map((s) => <a href={s}>{new URL(s).hostname}</a>)}</p>
      )}
      <p class="mono muted sources">
        <a href={`https://github.com/rajasekharponakala/awesome-watch-collection/edit/main/data/references/${ref.id}.yaml`}>Regulate this entry on GitHub →</a>
      </p>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section--tight">
      <div class="container">
        <span class="eyebrow" data-reveal="fade">Also in the box</span>
        <div class="grid grid--3" style="margin-top:28px">
          {related.map((r) => <div data-reveal><RefCard ref={r} brandName={brandName(r.data.brand)} /></div>)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .ref-hero { position: relative; padding: calc(var(--header-h) + 60px) 0 40px; overflow: hidden; }
  .ref-hero__rings { position: absolute; left: -20vw; top: 0; width: min(1000px, 110vw); opacity: 0.45; pointer-events: none; }
  .ref-hero__grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .ref-hero__visual { display: grid; place-items: center; perspective: 1200px; }
  .ref-hero__follow { transform: rotateY(var(--fx, 0deg)) rotateX(var(--fy, 0deg)); transition: transform 1.2s var(--ease); filter: drop-shadow(0 40px 50px rgba(0, 0, 0, 0.5)); }
  .ref-hero__chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 26px; }
  .warranty {
    max-width: 920px;
    padding: clamp(24px, 4vw, 50px);
    border: 1px solid var(--line-2);
    border-radius: 26px;
    background:
      repeating-linear-gradient(45deg, transparent 0 22px, color-mix(in srgb, var(--gold) 4%, transparent) 22px 23px),
      linear-gradient(180deg, var(--surface-2), var(--surface));
  }
  .warranty__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-bottom: 26px; }
  .gold-link { color: var(--gold); border-bottom: 1px solid currentColor; }
  .sources { margin: 22px 0 0; font-size: 12px; display: flex; flex-wrap: wrap; gap: 12px; }
  .sources a { color: var(--gold); }
  @media (max-width: 900px) { .ref-hero__grid { grid-template-columns: 1fr; gap: 20px; } }
</style>
