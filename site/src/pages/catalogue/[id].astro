---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RefVisual from '../../components/RefVisual.astro';
import RefCard from '../../components/RefCard.astro';
import Rings from '../../components/Rings.astro';
import { u, typeOf, subtypeOf, TYPE_META, TIER_META, LEVEL_META } from '../../lib/meta';
import { lineageMembers } from '../../lib/lineage';

export async function getStaticPaths() {
  const refs = await getCollection('references');
  return refs.map((r) => ({ params: { id: r.id }, props: { ref: r } }));
}
const { ref } = Astro.props;
const d = ref.data;
const brands = await getCollection('brands');
const brand = brands.find((b) => b.id === d.brand);
const calibers = await getCollection('calibers');
const cal = d.caliber_id ? calibers.find((c) => c.id === d.caliber_id) : undefined;
const t = typeOf(d.type);
const lineage = d.lineage ? (await getCollection('lineages')).find((l) => l.id === d.lineage) : undefined;
const members = lineage ? await lineageMembers(lineage.id) : [];
const pos = members.findIndex((m) => m.id === ref.id);
const prevRef = pos > 0 ? members[pos - 1] : undefined;
const nextRef = pos >= 0 && pos < members.length - 1 ? members[pos + 1] : undefined;
const related = (await getCollection('references'))
  .filter((r) => r.id !== ref.id && !members.some((m) => m.id === r.id) && (r.data.brand === d.brand || typeOf(r.data.type) === t))
  .slice(0, 3);
const brandName = (id: string) => brands.find((b) => b.id === id)?.data.name ?? id;

const specs: [string, string | undefined][] = [
  ['Reference', d.reference],
  ['Family', `${TYPE_META[t].name} · ${subtypeOf(d.type)}`],
  ['Movement', d.caliber],
  ['Case', d.case.material],
  ['Diameter', d.case.diameter_mm ? `${d.case.diameter_mm} mm` : undefined],
  ['Lug-to-lug', d.case.lug_to_lug_mm ? `${d.case.lug_to_lug_mm} mm` : undefined],
  ['Thickness', d.case.thickness_mm ? `${d.case.thickness_mm} mm` : undefined],
  ['Lug width', d.case.lug_width_mm ? `${d.case.lug_width_mm} mm` : undefined],
  ['Water resistance', d.water_resistance_m ? `${d.water_resistance_m} m` : undefined],
  ['Crystal', d.crystal],
  ['Functions', d.complications.length ? d.complications.join(', ') : undefined],
  ['Style', d.styles.join(', ')],
  ['Produced', d.years.introduced ? (d.years.discontinued ? `${d.years.introduced}–${d.years.discontinued}` : d.years.current ? `${d.years.introduced}–present` : `From ${d.years.introduced}`) : undefined],
  ['Origin', d.region],
  ['Price tier', `${TIER_META[d.price_tier].name} (${TIER_META[d.price_tier].range})`],
];
---

<Base title={`${brand?.data.name ?? ''} ${d.name}`} description={d.summary}>
  <section class="ref-hero">
    <div class="ref-hero__rings" data-parallax="0.3"><Rings /></div>
    <div class="container ref-hero__grid">
      <div class="ref-hero__visual" data-reveal="scale">
        <div class="ref-hero__follow" data-follow><RefVisual ref={ref} brandName={brand?.data.name ?? ''} size="min(500px, 84vw)" /></div>
      </div>
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb" data-reveal="fade">
          <a href={u()}>Dial</a><span>/</span><a href={u('catalogue/')}>Catalogue</a><span>/</span>
          <a href={u(`brands/${d.brand}/`)}>{brand?.data.name}</a>
        </nav>
        <span class="eyebrow" data-reveal="fade">{brand?.data.name}{d.reference ? ` · Ref. ${d.reference}` : ''}</span>
        <h1 class="display h2" data-reveal style="margin:18px 0 22px">{d.name}</h1>
        <p class="lede" data-reveal>{d.summary}</p>
        <div class="ref-hero__chips" data-reveal>
          {d.levels.map((l) => <span class="chip">{LEVEL_META[l].name}</span>)}
          {d.styles.map((s) => <span class="chip">{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container"><div class="warranty" data-reveal>
      <div class="warranty__head">
        <span class="eyebrow">Certificate · Spec sheet</span>
        <span class="mono muted">Serviced {d.last_reviewed.toISOString().slice(0, 10)}</span>
      </div>
      <dl class="specs">
        {specs.filter(([, v]) => v).map(([k, v]) => (
          <div><dt>{k}</dt><dd>{k === 'Movement' && cal ? <a href={u(`calibers/#${cal.id}`)} class="gold-link">{v}</a> : v}</dd></div>
        ))}
      </dl>
      {d.sources.length > 0 && (
        <p class="mono muted sources">Sources: {d.sources.map((s) => <a href={s}>{new URL(s).hostname}</a>)}</p>
      )}
      <p class="mono muted sources">
        <a href={`https://github.com/rajasekharponakala/awesome-watch-collection/edit/main/data/references/${ref.id}.yaml`}>Regulate this entry on GitHub →</a>
      </p>
    </div></div>
  </section>

  {lineage && (
    <section class="section--tight">
      <div class="container" data-reveal>
        <div class="lin-panel paint">
          <div class="lin-panel__head">
            <span class="eyebrow">Part of a lineage</span>
            <a href={u(`lineages/${lineage.id}/#${ref.id}`)} class="display h4 lin-panel__title">{lineage.data.name}: {pos + 1} of {members.length} →</a>
            {d.milestone && <p class="muted">{d.milestone}</p>}
          </div>
          <div class="lin-panel__nav">
            {prevRef ? (
              <a href={u(`catalogue/${prevRef.id}/`)} class="card"><span class="mono muted">← Before · {prevRef.data.years.introduced ?? '?'}</span><strong>Ref. {prevRef.data.reference}</strong></a>
            ) : <span class="lin-panel__end mono muted">The first of the line</span>}
            {nextRef ? (
              <a href={u(`catalogue/${nextRef.id}/`)} class="card lin-panel__next"><span class="mono muted">After · {nextRef.data.years.introduced ?? '?'} →</span><strong>Ref. {nextRef.data.reference}</strong></a>
            ) : <span class="lin-panel__end mono muted">The latest of the line</span>}
          </div>
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section--tight">
      <div class="container">
        <span class="eyebrow" data-reveal="fade">Also in the box</span>
        <div class="grid grid--3" style="margin-top:28px">
          {related.map((r) => <div data-reveal><RefCard ref={r} brandName={brandName(r.data.brand)} /></div>)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .ref-hero { position: relative; padding: calc(var(--header-h) + 60px) 0 56px; border-bottom: var(--bw) solid var(--ink); overflow: hidden; }
  .ref-hero__rings { position: absolute; left: -20vw; top: 0; width: min(1000px, 110vw); opacity: 0.2; pointer-events: none; }
  .ref-hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 60px; align-items: center; }
  .ref-hero__visual { display: grid; place-items: center; perspective: 1200px; padding: clamp(24px, 4vw, 48px); border: var(--bw) solid var(--ink); border-radius: var(--radius); background: var(--c-yellow) radial-gradient(rgba(17, 17, 17, 0.16) 1.4px, transparent 1.6px) 0 0 / 18px 18px; box-shadow: var(--shadow-lg); }
  .ref-hero__follow { transform: rotateY(var(--fx, 0deg)) rotateX(var(--fy, 0deg)); transition: transform 1.2s var(--ease); }
  .ref-hero__visual { min-width: 0; }
  .ref-hero__chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 26px; }
  .warranty {
    max-width: 920px;
    padding: clamp(24px, 4vw, 50px);
    border: var(--bw) solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface) repeating-linear-gradient(45deg, transparent 0 22px, color-mix(in srgb, var(--ink) 7%, transparent) 22px 24px);
    box-shadow: var(--shadow-lg);
  }
  .warranty__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-bottom: 26px; }
  .lin-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: center; max-width: 920px; padding: clamp(22px, 3vw, 36px); border: var(--bw) solid var(--ink); border-radius: var(--radius); background: var(--c-blue); box-shadow: var(--shadow-lg); }
  .lin-panel__title { display: block; margin: 12px 0 8px; }
  .lin-panel__title:hover { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 6px; }
  .lin-panel__head p { margin: 0; font-size: 15px; }
  .lin-panel__nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lin-panel__nav .card { display: grid; gap: 6px; padding: 16px 18px; }
  .lin-panel__nav .mono { font-size: 11px; }
  .lin-panel__next { text-align: right; }
  .lin-panel__end { display: grid; place-items: center; padding: 16px; border: var(--bw) dashed #111; border-radius: var(--radius); font-size: 11px; font-weight: 700; text-align: center; }
  @media (max-width: 760px) { .lin-panel { grid-template-columns: minmax(0, 1fr); } }
  .gold-link { font-weight: 700; background: linear-gradient(var(--c-yellow), var(--c-yellow)) 0 100% / 100% 0.35em no-repeat; }
  .gold-link:hover { background-size: 100% 100%; color: #111; }
  .sources { margin: 22px 0 0; font-size: 12px; display: flex; flex-wrap: wrap; gap: 8px; }
  .sources a { padding: 2px 8px; border: var(--bw-sm) solid var(--ink); border-radius: 5px; font-weight: 700; box-shadow: 2px 2px 0 var(--ink); }
  .sources a:hover { background: var(--c-blue); color: #111; }
  @media (max-width: 900px) { .ref-hero__grid { grid-template-columns: minmax(0, 1fr); gap: 20px; } .ref-hero__follow :global(.watch), .ref-hero__follow :global(.dface) { --size: min(380px, 78vw) !important; } }
</style>
