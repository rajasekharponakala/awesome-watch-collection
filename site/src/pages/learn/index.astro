---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { u, LEVELS, LEVEL_META } from '../../lib/meta';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Learn" description="Four learning paths: First Wind, Automatic, Complication and Grande Complication.">
  <PageHero
    eyebrow="Learning paths"
    title="Wind up your <em>knowledge.</em>"
    lede="Four levels, each named after a stage of horology. Start at First Wind, or jump to whatever matches what you already know."
    crumbs={[[u(), 'Dial'], [u('learn/'), 'Learn']]}
  />
  <section class="section--tight">
    <div class="container levels">
      {LEVELS.map((lv, i) => {
        const meta = LEVEL_META[lv];
        const list = guides.filter((g) => g.data.level === lv);
        return (
          <article class="level card" data-reveal style={`--d:${i * 0.08}s`} data-level-card={lv}>
            <a href={u(`learn/${lv}/`)} class="level__head">
              <span class="level__num display">{['I', 'II', 'III', 'IV'][i]}</span>
              <div>
                <span class="jewels">{[1, 2, 3, 4].map((j) => <i class={j > meta.jewels ? 'off' : ''} />)}</span>
                <h2 class="display h3">{meta.name}</h2>
                <p class="mono muted">{meta.stage} · {list.length} guides <span class="mine-badge">Your level</span></p>
              </div>
            </a>
            <p class="lede">{meta.blurb}</p>
            <ol class="level__list">
              {list.map((g, k) => (
                <li>
                  <a href={u(`learn/${g.id}/`)}>
                    <span class="mono">{String(k + 1).padStart(2, '0')}</span>
                    <span><strong>{g.data.title}</strong><small>{g.data.description}</small></span>
                    <Icon name="arrow" />
                  </a>
                </li>
              ))}
            </ol>
          </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .levels { display: grid; gap: 28px; }
  .level { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 20px 60px; padding: clamp(26px, 4vw, 56px); }
  .level__head { display: flex; gap: 28px; align-items: start; }
  .level__num { font-size: clamp(70px, 9vw, 130px); line-height: 0.8; color: var(--c-yellow); -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill; text-shadow: 6px 6px 0 var(--ink); }
  .level__head h2 { margin: 14px 0 6px; }
  .level__head p { margin: 0; }
  .level > .lede { grid-column: 1; margin: 0; font-size: 17px; }
  .level__list { grid-column: 2; grid-row: 1 / span 2; list-style: none; margin: 0; padding: 0; border: var(--bw) solid var(--ink); border-radius: var(--radius-sm); background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
  .level__list li + li { border-top: var(--bw-sm) solid var(--ink); }
  .level__list a { display: grid; grid-template-columns: 36px 1fr 20px; gap: 14px; align-items: center; padding: 14px 16px; transition: padding 0.2s var(--ease), background-color 0.15s; }
  .level__list a:hover { padding-left: 24px; background: var(--c-yellow); --muted: #2b2925; color: #111; }
  .level__list .mono { font-weight: 700; }
  .level__list strong { display: block; font-weight: 700; }
  .level__list small { display: block; color: var(--muted); font-size: 14px; line-height: 1.5; }
  .level__list svg { width: 20px; stroke-width: 2.4; }
  @media (max-width: 900px) {
    .level { grid-template-columns: 1fr; }
    .level > .lede, .level__list { grid-column: auto; grid-row: auto; }
  }
</style>
