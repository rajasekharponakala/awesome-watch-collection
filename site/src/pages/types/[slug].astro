---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import TypeGlyph from '../../components/TypeGlyph.astro';
import RefCard from '../../components/RefCard.astro';
import { u, typeOf } from '../../lib/meta';

export async function getStaticPaths() {
  const types = await getCollection('types');
  return types.map((t) => ({ params: { slug: t.id }, props: { type: t } }));
}
const { type } = Astro.props;
const { Content } = await render(type);
const refs = (await getCollection('references')).filter((r) => typeOf(r.data.type) === type.data.glyph);
const brands = await getCollection('brands');
const brandName = (id: string) => brands.find((b) => b.id === id)?.data.name ?? id;
---

<Base title={type.data.title} description={type.data.tagline}>
  <PageHero eyebrow="Watch family" title={type.data.title} lede={type.data.tagline} crumbs={[[u(), 'Dial'], [u('types/'), 'Types'], [u(`types/${type.id}/`), type.data.title]]}>
    <div class="t-glyph" data-parallax="-0.15"><TypeGlyph type={type.data.glyph} /></div>
  </PageHero>

  <section class="section--tight">
    <div class="container">
      <dl class="t-facts" data-reveal>
        {type.data.facts.map((f) => (
          <div><dt class="mono">{f.k}</dt><dd class="display h4">{f.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <span class="eyebrow" data-reveal="fade">Sub-categories</span>
      <div class="grid grid--2 t-subs">
        {type.data.subcategories.map((s, i) => (
          <div class="card" data-reveal style={`--d:${i * 0.06}s`}>
            <span class="mono t-sub-no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display h4">{s.name}</h3>
            <p class="muted">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container"><div class="prose" data-reveal="fade"><Content /></div></div>
  </section>

  {refs.length > 0 && (
    <section class="section--tight">
      <div class="container">
        <span class="eyebrow" data-reveal="fade">In the catalogue</span>
        <div class="grid grid--4" style="margin-top:28px">
          {refs.map((r) => <div data-reveal><RefCard ref={r} brandName={brandName(r.data.brand)} /></div>)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .t-glyph { position: absolute; right: var(--gutter); top: calc(var(--header-h) + 60px); width: min(340px, 30vw); opacity: 0.9; }
  @media (max-width: 900px) { .t-glyph { position: relative; right: auto; top: auto; width: 160px; margin-top: 30px; } }
  .t-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 18px; margin: 0; }
  .t-facts div { padding: 20px 22px; border: var(--bw) solid var(--ink); border-radius: var(--radius-sm); background: var(--surface); box-shadow: var(--shadow); }
  .t-facts div:nth-child(4n + 1) { border-top: 12px solid var(--ink); }
  .t-facts dt { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .t-facts dd { margin: 10px 0 0; font-weight: 600; }
  .t-subs { margin-top: 28px; }
  .t-sub-no { display: inline-block; padding: 1px 7px; background: var(--ink); color: var(--bg); font-weight: 700; }
  .t-subs h3 { margin: 10px 0 8px; }
  .t-subs p { margin: 0; }
</style>
