---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Watch from '../components/Watch.astro';
import Rings from '../components/Rings.astro';
import TypeGlyph from '../components/TypeGlyph.astro';
import RefCard from '../components/RefCard.astro';
import RefVisual from '../components/RefVisual.astro';
import Icon from '../components/Icon.astro';
import { u, LEVELS, LEVEL_META, TYPE_META } from '../lib/meta';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const types = (await getCollection('types')).sort((a, b) => a.data.order - b.data.order);
const brands = await getCollection('brands');
const calibers = await getCollection('calibers');
const refs = await getCollection('references');
const lineageList = (await getCollection('lineages')).sort((a, b) => a.data.order - b.data.order);
const evolution = ['rolex-submariner-6204', 'rolex-submariner-5512', 'rolex-submariner-1680', 'rolex-submariner-16610', 'rolex-submariner-126610ln']
  .map((id) => refs.find((r) => r.id === id))
  .filter((r): r is NonNullable<typeof r> => !!r);
const glossary = await getCollection('glossary');
const timeline = (await getCollection('timeline')).sort((a, b) => a.data.year - b.data.year);
const brandName = (id: string) => brands.find((b) => b.id === id)?.data.name ?? id;

const featured = ['omega-speedmaster-professional', 'grand-seiko-snowflake-sbga211', 'casio-g-shock-dw5600', 'tudor-black-bay-58']
  .map((id) => refs.find((r) => r.id === id))
  .filter((r): r is NonNullable<typeof r> => !!r);

const dialNav = [
  { h: 0, n: 'XII', t: 'Learn', d: 'Four learning paths, from First Wind to Grande Complication.', href: 'learn/' },
  { h: 1, n: 'I', t: 'Mechanical', d: TYPE_META.mechanical.short, href: 'types/mechanical/' },
  { h: 2, n: 'II', t: 'Quartz', d: TYPE_META.quartz.short, href: 'types/quartz/' },
  { h: 3, n: 'III', t: 'Digital', d: TYPE_META.digital.short, href: 'types/digital/' },
  { h: 4, n: 'IV', t: 'Smart', d: TYPE_META.smart.short, href: 'types/smart/' },
  { h: 5, n: 'V', t: 'Hybrid', d: TYPE_META.hybrid.short, href: 'types/hybrid/' },
  { h: 6, n: 'VI', t: 'Exotic', d: TYPE_META.exotic.short, href: 'types/exotic/' },
  { h: 7, n: 'VII', t: 'Catalogue', d: 'Iconic references, laid out like spec sheets.', href: 'catalogue/' },
  { h: 8, n: 'VIII', t: 'Calibers', d: 'The engines: beat rates, jewels and power reserves.', href: 'calibers/' },
  { h: 9, n: 'IX', t: 'Brands', d: 'Maisons, groups and independents.', href: 'brands/' },
  { h: 10, n: 'X', t: 'History', d: 'Five centuries on one chronograph.', href: 'history/' },
  { h: 11, n: 'XI', t: 'Glossary', d: 'Every term, from anglage to Zaratsu.', href: 'glossary/' },
];

const parts = [
  { i: 6, n: 'Crystal', d: 'Synthetic sapphire, second only to diamond in hardness, with anti-reflective coating.' },
  { i: 5, n: 'Case & bezel', d: 'Lugs, crown and a unidirectional bezel. The armour that keeps water and dust out.' },
  { i: 4, n: 'Hands', d: 'Hour, minute and a seconds hand stepping eight times a second, filled with lume.' },
  { i: 3, n: 'Dial', d: 'Sunburst finish, applied indices and a date window at three.' },
  { i: 2, n: 'Movement', d: 'Mainspring, gear train, escapement and a balance beating at 28,800 vph.' },
  { i: 1, n: 'Rotor', d: 'A weighted half-moon that winds the mainspring as your wrist moves.' },
  { i: 0, n: 'Caseback', d: 'A sapphire window onto the movement, sealed with a screw-down ring.' },
];

const stats = [
  { n: guides.length, l: 'Guides' },
  { n: refs.length, l: 'References' },
  { n: calibers.length, l: 'Calibers' },
  { n: brands.length, l: 'Brands' },
  { n: glossary.length, l: 'Glossary terms' },
  { n: new Date().getFullYear() - timeline[0].data.year, l: 'Years of history' },
];

const milestones = ['1510-portable-timekeeping', '1801-the-tourbillon', '1926-the-oyster', '1969-seiko-astron', '1983-swatch-and-g-shock', '2015-apple-watch']
  .map((id) => timeline.find((t) => t.id === id))
  .filter((t): t is NonNullable<typeof t> => !!t);

const tlData = JSON.stringify(timeline.map((t) => t.data));
const marquee = brands.map((b) => b.data.name);
---

<Base page="home">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__glow"></div>
      <div class="hero__rings" data-parallax="0.35"><Rings spin={180} /></div>
      <div class="hero__gear hero__gear--1" data-parallax="-0.5"><TypeGlyph type="mechanical" /></div>
      <div class="hero__gear hero__gear--2" data-parallax="0.6"><TypeGlyph type="exotic" /></div>
      <div class="hero__gear hero__gear--3" data-parallax="-0.25"><TypeGlyph type="mechanical" /></div>
    </div>

    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow" data-reveal="fade">The open encyclopaedia of watches</span>
        <h1 class="display h1 hero__title">
          <span class="split-line"><span>Time,</span></span>
          <span class="split-line"><span style="--d:.12s"><em class="gold-text">decoded.</em></span></span>
        </h1>
        <p class="lede" data-reveal style="--d:.3s">
          Mechanical, quartz, digital, smart and hybrid. Every movement, complication and maison, organised into a path that
          takes you from your first wind to grand complications.
        </p>
        <div class="hero__ctas" data-reveal style="--d:.45s">
          <a class="btn btn--gold" href={u('learn/')} data-magnetic data-level-cta><span data-label>Start winding</span> <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={u('catalogue/')} data-magnetic>Explore the catalogue</a>
        </div>
        <dl class="hero__readout mono" data-reveal="fade" style="--d:.6s">
          <div><dt>Local time</dt><dd data-readout>--:--:--</dd></div>
          <div><dt>Beat</dt><dd>28,800 vph</dd></div>
          <div><dt>Ref.</dt><dd>AWC-001</dd></div>
        </dl>
      </div>

      <div class="hero__watch" data-parallax="-0.12">
        <div class="hero__follow" data-follow>
          <div class="hero__halo" aria-hidden="true"></div>
          <Watch metal="gold" bezel="dive" dial="#0c1014" label="AWC" sub="AUTOMATIC · 28800" size="min(560px, 86vw)" />
        </div>
      </div>
    </div>

    <a href="#inside" class="hero__cue" aria-label="Scroll to explore">
      <span class="mono">Wind down</span><i></i>
    </a>
  </section>

  <!-- ============ MARQUEE ============ -->
  <section class="marquee" aria-label="Brands in the collection">
    {[0, 1].map((row) => (
      <div class={`marquee__row ${row ? 'marquee__row--rev' : ''}`} aria-hidden={row ? 'true' : undefined}>
        {[0, 1].map(() => (
          <div class="marquee__set">
            {(row ? [...marquee].reverse() : marquee).map((n) => <span>{n}<i>◆</i></span>)}
          </div>
        ))}
      </div>
    ))}
  </section>

  <!-- ============ EXPLODED VIEW ============ -->
  <section class="explode" id="inside" data-scene data-explode>
    <div class="explode__sticky">
      <div class="container explode__grid">
        <div class="explode__copy">
          <span class="eyebrow">Inside the machine</span>
          <h2 class="display h2">Seven layers.<br /><em>One heartbeat.</em></h2>
          <p class="lede">Scroll to take a watch apart, from sapphire crystal to caseback.</p>
          <ol class="explode__parts">
            {parts.map((p, k) => (
              <li data-part={String(p.i)}>
                <span class="mono">{String(k + 1).padStart(2, '0')}</span>
                <div><strong>{p.n}</strong><p>{p.d}</p></div>
              </li>
            ))}
          </ol>
        </div>
        <div class="explode__view">
          <div class="explode__stage" data-stage>
            <Watch layers="all" explode metal="gold" bezel="dive" dial="#0c1014" label="AWC" sub="AUTOMATIC · 28800" size="min(470px, 76vw)" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THE DIAL ============ -->
  <section class="section dialnav-sec">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow" data-reveal="fade">The Dial</span>
        <h2 class="display h2" data-reveal>Twelve indices.<br /><em>Every horizon.</em></h2>
        <p class="lede" data-reveal>Each hour marker leads to a part of the library. Point at an index and the hand will find it, or tap one to go there.</p>
      </div>

      <div class="dialnav" data-dialnav data-reveal="scale">
        <div class="dialnav__face">
          <div class="dialnav__track" aria-hidden="true"></div>
          <div class="dialnav__hand" data-dialnav-hand aria-hidden="true"><i></i></div>
          <div class="dialnav__info" data-dialnav-info>
            <span class="eyebrow">Now pointing at</span>
            <strong class="display" data-t>Learn</strong>
            <span data-d>{dialNav[0].d}</span>
          </div>
          {dialNav.map((x) => (
            <a href={u(x.href)} class="dialnav__idx" style={`--h:${x.h}`} data-hour={x.h} data-title={x.t} data-desc={x.d}>
              <span class="dialnav__n">{x.n}</span>
              <span class="dialnav__t">{x.t}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LEARNING PATHS ============ -->
  <section class="section paths">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow" data-reveal="fade">Learning paths</span>
        <h2 class="display h2" data-reveal>From first wind<br /><em>to grande complication.</em></h2>
      </div>
      <div class="stack">
        {LEVELS.map((lv, i) => {
          const meta = LEVEL_META[lv];
          const list = guides.filter((g) => g.data.level === lv);
          return (
            <a href={u(`learn/${lv}/`)} class="stack__card" style={`--i:${i}`} data-level-card={lv}>
              <div class="stack__num display">{['I', 'II', 'III', 'IV'][i]}</div>
              <div class="stack__body">
                <div class="stack__top">
                  <span class="jewels" aria-label={`${meta.jewels} of 4 jewels`}>
                    {[1, 2, 3, 4].map((j) => <i class={j > meta.jewels ? 'off' : ''} />)}
                  </span>
                  <span class="mono muted">{meta.stage} · {list.length} guides</span>
                  <span class="mine-badge">Your level</span>
                </div>
                <h3 class="display h3">{meta.name}</h3>
                <p class="lede">{meta.blurb}</p>
                <ul class="stack__list">
                  {list.slice(0, 4).map((g) => <li>{g.data.title}</li>)}
                </ul>
                <span class="btn btn--ghost">Begin {meta.name} <Icon name="arrow" /></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ TYPES (horizontal) ============ -->
  <section class="hs" data-hscroll aria-label="Watch families">
    <div class="hs__sticky">
      <div class="hs__track" data-track>
        <div class="hs__intro">
          <span class="eyebrow">Six families</span>
          <h2 class="display h2">One<br /><em>obsession.</em></h2>
          <p class="lede">Every watch ever made belongs to one of these families. Keep scrolling to travel through them.</p>
          <div class="hs__bar"><i></i></div>
        </div>
        {types.map((t, i) => (
          <a href={u(`types/${t.id}/`)} class="hs__panel">
            <span class="hs__bigword display" aria-hidden="true">{t.data.title}</span>
            <div class="hs__glyph"><TypeGlyph type={t.data.glyph} /></div>
            <div class="hs__text">
              <span class="mono hs__no">{String(i + 1).padStart(2, '0')} / {String(types.length).padStart(2, '0')}</span>
              <h3 class="display h3">{t.data.title}</h3>
              <p>{t.data.tagline}</p>
              <dl class="hs__facts">
                {t.data.facts.slice(0, 3).map((f) => (
                  <div><dt class="mono">{f.k}</dt><dd>{f.v}</dd></div>
                ))}
              </dl>
              <span class="btn btn--ghost">Explore {t.data.title} <Icon name="arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="section--tight stats">
    <div class="container">
      <div class="track" data-reveal="fade"></div>
      <div class="stats__grid">
        {stats.map((s, i) => (
          <div class="stats__item" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="display stats__n" data-count={s.n}>0</span>
            <span class="mono muted">{s.l}</span>
          </div>
        ))}
      </div>
      <div class="track" data-reveal="fade"></div>
    </div>
  </section>

  <!-- ============ HISTORY + DATE WINDOW ============ -->
  <section class="section history-teaser">
    <div class="container">
      <div class="grid grid--2 history-teaser__grid">
        <div>
          <span class="eyebrow" data-reveal="fade">Chronograph</span>
          <h2 class="display h2" data-reveal>Five centuries<br /><em>in one sweep.</em></h2>
          <p class="lede" data-reveal>From Nuremberg's first portable clocks to the smartwatch on your wrist. Start, stop and reset the history of time.</p>
          <a class="btn btn--ghost" href={u('history/')} data-reveal data-magnetic>Start the chronograph <Icon name="arrow" /></a>
        </div>
        <div class="card datewin" data-reveal="scale" data-tilt="5">
          <div class="datewin__head">
            <span class="eyebrow" data-dw-kind>Today in watch history</span>
            <div class="datewin__window mono"><span data-dw-mon>OCT</span><b data-dw-day>16</b></div>
          </div>
          <span class="display datewin__year" data-dw-year>1969</span>
          <h3 class="display h4" data-dw-title>Seiko Astron</h3>
          <p class="muted" data-dw-text>Seiko sells the Astron 35SQ in Tokyo, the world's first quartz wristwatch.</p>
        </div>
      </div>

      <ol class="sweep" data-reveal="fade">
        {milestones.map((m, i) => (
          <li style={`--d:${0.1 + i * 0.12}s`}>
            <span class="display">{m.data.year}</span>
            <strong>{m.data.title}</strong>
          </li>
        ))}
      </ol>
    </div>
    <script type="application/json" id="tl-data" set:html={tlData} />
  </section>

  <!-- ============ LINEAGES ============ -->
  <section class="section evo">
    <div class="container">
      <div class="sec-head sec-head--row">
        <div>
          <span class="eyebrow" data-reveal="fade">Lineages</span>
          <h2 class="display h2" data-reveal>Every icon has <em>ancestors.</em></h2>
          <p class="lede" data-reveal>Seventy years of the Submariner in five steps. Each lineage page traces every reference, and what it changed.</p>
        </div>
        <div class="evo__links" data-reveal>
          {lineageList.map((l) => <a class="btn btn--ghost" href={u(`lineages/${l.id}/`)} data-magnetic>{l.data.name} <Icon name="arrow" /></a>)}
        </div>
      </div>
      <ol class="evo__row" data-reveal="fade">
        {evolution.map((r, i) => (
          <li style={`--d:${0.15 + i * 0.14}s`}>
            <a href={u(`lineages/rolex-submariner/#${r.id}`)} data-tilt="8">
              <RefVisual ref={r} brandName="Rolex" size="min(190px, 40vw)" />
              <span class="display evo__year">{r.data.years.introduced}</span>
              <span class="mono evo__ref">Ref. {r.data.reference}</span>
              <span class="evo__ms">{r.data.milestone}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ FEATURED ============ -->
  <section class="section featured">
    <div class="container">
      <div class="sec-head sec-head--row">
        <div>
          <span class="eyebrow" data-reveal="fade">From the catalogue</span>
          <h2 class="display h2" data-reveal>Icons on <em>the wrist.</em></h2>
        </div>
        <a class="btn btn--ghost" href={u('catalogue/')} data-reveal>View all {refs.length} references <Icon name="arrow" /></a>
      </div>
      <div class="grid grid--4">
        {featured.map((r, i) => (
          <div data-reveal style={`--d:${i * 0.1}s`}><RefCard ref={r} brandName={brandName(r.data.brand)} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ESCAPEMENT CTA ============ -->
  <section class="section escapement">
    <div class="escapement__rings" data-parallax="0.2" aria-hidden="true"><Rings spin={120} /></div>
    <div class="container escapement__inner">
      <span class="eyebrow" data-reveal="fade">The Escapement</span>
      <h2 class="display h1" data-reveal>Keep it <em class="gold-text">ticking.</em></h2>
      <p class="lede" data-reveal>
        Like an escapement, this library moves forward one small impulse at a time. Add a watch, correct a fact or write a guide.
        Every contribution is a beat.
      </p>
      <div class="hero__ctas" data-reveal>
        <a class="btn btn--gold" href="https://github.com/rajasekharponakala/awesome-watch-collection" data-magnetic><Icon name="github" /> Contribute on GitHub</a>
        <a class="btn btn--ghost" href={u('about/')} data-magnetic>Open the caseback</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Date window: pick today's anniversary, else something from this month, else a daily pick.
  const raw = document.getElementById('tl-data')?.textContent;
  if (raw) {
    type Ev = { year: number; month?: number; day?: number; title: string; text: string };
    const events = JSON.parse(raw) as Ev[];
    const now = new Date();
    const mon = now.getMonth() + 1;
    const day = now.getDate();
    const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
    let kind = 'On this day in watch history';
    let ev = events.find((e) => e.month === mon && e.day === day);
    if (!ev) {
      ev = events.find((e) => e.month === mon);
      kind = 'This month in watch history';
    }
    if (!ev) {
      const doy = Math.floor((+now - +new Date(now.getFullYear(), 0, 0)) / 864e5);
      ev = events[doy % events.length];
      kind = 'From the archive';
    }
    const set = (sel: string, v: string) => {
      const el = document.querySelector(sel);
      if (el) el.textContent = v;
    };
    set('[data-dw-kind]', kind);
    set('[data-dw-mon]', MONTHS[now.getMonth()]);
    set('[data-dw-day]', String(day));
    set('[data-dw-year]', String(ev.year));
    set('[data-dw-title]', ev.title);
    set('[data-dw-text]', ev.text);
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 40px) 0 100px;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 90vw;
    height: 90vw;
    max-width: 1300px;
    max-height: 1300px;
    background: radial-gradient(circle at 60% 40%, rgba(207, 174, 107, 0.16), transparent 55%);
  }
  [data-theme='day'] .hero__glow {
    background: radial-gradient(circle at 60% 40%, rgba(155, 116, 50, 0.16), transparent 55%);
  }
  .hero__rings {
    position: absolute;
    right: -14vw;
    top: 50%;
    width: min(1200px, 120vw);
    margin-top: calc(min(1200px, 120vw) / -2);
    opacity: 0.6;
  }
  .hero__gear {
    position: absolute;
    opacity: 0.18;
  }
  .hero__gear--1 { width: 220px; left: -60px; top: 18%; }
  .hero__gear--2 { width: 150px; left: 42%; bottom: 6%; }
  .hero__gear--3 { width: 120px; right: 6%; top: 12%; }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
  }
  .hero__title {
    margin: 26px 0 30px;
    font-size: clamp(64px, 10.5vw, 176px);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }
  .hero__readout {
    display: flex;
    flex-wrap: wrap;
    gap: 34px;
    margin: 56px 0 0;
    font-size: 12px;
  }
  .hero__readout dt {
    color: var(--faint);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 10px;
  }
  .hero__readout dd {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--text);
  }
  .hero__watch {
    display: grid;
    place-items: center;
    perspective: 1400px;
  }
  .hero__follow {
    position: relative;
    transform: rotateY(var(--fx, 0deg)) rotateX(var(--fy, 0deg));
    transition: transform 1.2s var(--ease);
    transform-style: preserve-3d;
    animation: float 9s ease-in-out infinite;
  }
  .hero__halo {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(207, 174, 107, 0.35), transparent 70%);
    filter: blur(50px);
    transform: translateZ(-80px);
  }
  .hero__follow :global(.watch) {
    filter: drop-shadow(0 50px 60px rgba(0, 0, 0, 0.55));
  }
  @keyframes float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -16px; }
  }
  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .hero__cue i {
    width: 1px;
    height: 54px;
    background: linear-gradient(var(--gold), transparent);
    animation: cue 2.2s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); }
    100% { transform: scaleY(1); opacity: 0; }
  }
  @media (max-width: 960px) {
    .hero { min-height: auto; padding-bottom: 72px; }
    .hero__grid { grid-template-columns: minmax(0, 1fr); text-align: left; gap: 8px; }
    .hero__watch { order: -1; }
    .hero__follow :global(.watch) { --size: min(400px, 62vw) !important; }
    .hero__title { margin: 18px 0 20px; }
